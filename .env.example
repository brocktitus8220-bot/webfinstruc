# Clerk. Leave blank to run in local demo mode (no sign-in required).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/1

# API client mode: "mock" (default, sample data in the browser) or "http"
# (the real API backed by Postgres). The base URL defaults to this app's
# own routes at /api/v1; set it only to point at another server.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=

# Postgres, used by the real API (NEXT_PUBLIC_API_MODE=http)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Plaid bank and card connections. Leave blank to keep them off; everything
# else, including sample mode and Apple Card statement import, still works.
# Needs NEXT_PUBLIC_API_MODE=http and Postgres. Get keys at dashboard.plaid.com.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (test banks, user_good / pass_good) or production
PLAID_ENV=sandbox
# Encrypts stored access tokens. Generate with: openssl rand -base64 32
PLAID_TOKEN_KEY=
# Public URL of /api/plaid/webhook, for automatic transaction updates (optional)
PLAID_WEBHOOK_URL=
# Public URL of /app/plaid-oauth, needed for OAuth banks in production (optional)
PLAID_REDIRECT_URI=
